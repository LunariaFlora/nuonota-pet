<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NuonotaPet</AssemblyName><RootNamespace>NuonotaPet</RootNamespace>
    <Version>0.6.0</Version><ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <!-- This is a WPF application; Forms is used only for NotifyIcon and screen bounds. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
</Project>
